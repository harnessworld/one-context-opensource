# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# ── Virtual environments (any name, any count) ────────────────────────────
.venv*/
venv/
env/

# ── Secrets and per-machine settings ──────────────────────────────────────
.env
.env.*
.onecxt/local.yaml
.onecxt/sensitive-words.yaml

# ── Runtime state written by onecxt ───────────────────────────────────────
adapt-report.json
.onecxt/adapt-cache.json

# Repositories cloned by `onecxt sync` (registered in meta/repos.yaml)
repos/

# Scratch space (context exports, hero previews, throwaway outputs)
tmp/

# Local agent/memory runtime (keep an optional README if present)
memory/*
!memory/README.md

# Log files
*.log

# Local vault/editor settings
.obsidian/

# Node tooling (e.g. custom skill scripts)
node_modules/

# Feature worktrees created by `onecxt worktree`
.worktrees/
features/**/worktrees.yaml

# ── Generated tool surfaces (regenerated by `onecxt adapt`) ──────────────
# NOTE: the root AGENTS.md is intentionally NOT ignored — it is normally
# committed so tools work before the first `adapt` run.
CLAUDE.md
.hermes.md
.claude/
.codex/
.cursor/
.hermes/
.openclaw/
.opencode/
.pi/
.agents/

# ── Editor / OS noise ─────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/
